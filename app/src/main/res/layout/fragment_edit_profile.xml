<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/mp_screen_padding">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back"
                style="@style/MpIconButton"
                app:srcCompat="@drawable/ic_back"
                android:contentDescription="@string/back" />
            <TextView
                style="@style/MpTitle"
                android:text="@string/edit_profile"
                android:layout_width="0dp"
                android:layout_weight="1" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView style="@style/MpAvatarPersonLarge" />
        <TextView
            style="@style/MpLabel"
            android:text="@string/name"
            android:labelFor="@id/owner_name" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/owner_name_field"
            style="@style/MpField">
            <com.google.android.material.textfield.TextInputEditText
                style="@style/MpInput"
                android:id="@+id/owner_name"
                android:hint="@string/name_hint"
                android:inputType="textPersonName"
                android:importantForAutofill="no"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            style="@style/MpLabel"
            android:text="@string/email"
            android:labelFor="@id/owner_email" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/owner_email_field"
            style="@style/MpField">
            <com.google.android.material.textfield.TextInputEditText
                style="@style/MpInput"
                android:id="@+id/owner_email"
                android:hint="@string/email_hint"
                android:inputType="textEmailAddress"
                android:importantForAutofill="no"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            style="@style/MpLabel"
            android:text="@string/phone"
            android:labelFor="@id/owner_phone" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/owner_phone_field"
            style="@style/MpField">
            <com.example.mobile.ui.common.PhoneInputEditText
                style="@style/MpInput"
                android:fontFamily="monospace"
                android:id="@+id/owner_phone"
                android:hint="@string/phone_hint"
                android:inputType="phone"
                android:importantForAutofill="no"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            style="@style/MpCaption"
            android:id="@+id/form_message"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            style="@style/MpButton"
            android:id="@+id/save"
            android:text="@string/save_changes" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>