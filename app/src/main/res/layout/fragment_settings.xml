<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/mp_screen_padding">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back"
                style="@style/MpIconButton"
                app:srcCompat="@drawable/ic_back"
                android:contentDescription="@string/back" />
            <TextView
                style="@style/MpTitle"
                android:text="@string/settings"
                android:layout_width="0dp"
                android:layout_weight="1" />
        </LinearLayout>
        <TextView
            style="@style/MpSection"
            android:text="@string/application" />
        <LinearLayout style="@style/MpCard">
            <TextView
                style="@style/MpLabel"
                android:text="@string/language"
                android:labelFor="@id/language" />
            <androidx.appcompat.widget.AppCompatSpinner
                style="@style/MpSpinner"
                android:id="@+id/language"
                android:entries="@array/languages" />
            <TextView
                style="@style/MpLabel"
                android:text="@string/theme"
                android:labelFor="@id/theme" />
            <androidx.appcompat.widget.AppCompatSpinner
                style="@style/MpSpinner"
                android:id="@+id/theme"
                android:entries="@array/theme_options" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/reminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/reminders"
                android:checked="false" />
            <TextView
                style="@style/MpCaption"
                android:text="@string/reminders_caption" />
            <TextView
                style="@style/MpLabel"
                android:text="@string/reminder_time"
                android:labelFor="@id/reminder_time" />
            <androidx.appcompat.widget.AppCompatSpinner
                style="@style/MpSpinner"
                android:id="@+id/reminder_time"
                android:entries="@array/reminder_options" />
            <TextView
                style="@style/MpCaption"
                android:text="@string/reminder_note" />
            <TextView
                style="@style/MpLabel"
                android:text="@string/weight_units"
                android:labelFor="@id/weight_units" />
            <androidx.appcompat.widget.AppCompatSpinner
                style="@style/MpSpinner"
                android:id="@+id/weight_units"
                android:entries="@array/unit_options" />
        </LinearLayout>
        <TextView
            style="@style/MpSection"
            android:text="@string/account" />
        <com.google.android.material.button.MaterialButton
            style="@style/MpButtonSoft"
            android:id="@+id/privacy"
            android:text="@string/privacy" />
        <com.google.android.material.button.MaterialButton
            style="@style/MpButtonSoft"
            android:id="@+id/terms"
            android:text="@string/terms" />
        <com.google.android.material.button.MaterialButton
            style="@style/MpButtonSoft"
            android:id="@+id/about"
            android:text="@string/about" />
        <com.google.android.material.button.MaterialButton
            style="@style/MpButtonSoft"
            android:id="@+id/logout"
            android:text="@string/logout" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>