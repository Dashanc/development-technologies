<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/mp_screen_padding">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                style="@style/MpTitle"
                android:text="@string/health"
                android:layout_width="0dp"
                android:layout_weight="1" />
        </LinearLayout>
        <TextView
            style="@style/MpCaption"
            android:text="@string/health_caption" />
        <LinearLayout
            style="@style/MpCard"
            android:background="@drawable/bg_accent"
            android:layout_marginTop="20dp"
            android:id="@+id/health_summary_card"
            android:visibility="gone"
            tools:visibility="visible">
            <androidx.appcompat.widget.AppCompatImageView
                style="@style/MpIcon"
                app:srcCompat="@drawable/ic_health" />
            <TextView
                style="@style/MpSection"
                android:textColor="@color/mp_primary"
                android:id="@+id/health_status"
                tools:text="@string/all_calm" />
            <TextView
                style="@style/MpCaption"
                android:id="@+id/health_summary"
                tools:text="2 питомца · 1 событие впереди" />
        </LinearLayout>
        <TextView
            style="@style/MpSection"
            android:text="@string/upcoming_events" />
        <TextView
            style="@style/MpCaption"
            android:id="@+id/upcoming_empty"
            android:text="@string/no_upcoming_events"
            tools:visibility="gone" />
        <LinearLayout
            style="@style/MpCard"
            android:id="@+id/upcoming_event"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:visibility="gone"
            tools:visibility="visible">
            <TextView
                style="@style/MpText"
                android:textStyle="bold"
                tools:text="Питомец · событие"
                android:id="@+id/event_title" />
            <TextView
                style="@style/MpCaption"
                tools:text="22 ноября 2026"
                android:id="@+id/event_date" />
        </LinearLayout>
        <TextView
            style="@style/MpSection"
            android:text="@string/my_pets" />
        <TextView
            style="@style/MpCaption"
            android:id="@+id/health_pets_empty"
            android:text="@string/no_pets"
            tools:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/health_pets_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_health_pet"
            tools:itemCount="2" />
        <com.google.android.material.button.MaterialButton
            style="@style/MpButtonSoft"
            android:id="@+id/all_records"
            android:text="@string/all_records" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>