<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/mp_primary_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/mp_primary" />
            <corners android:radius="@dimen/mp_control_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/mp_card" />
            <stroke
                android:width="1dp"
                android:color="@color/mp_outline" />
            <corners android:radius="@dimen/mp_control_radius" />
        </shape>
    </item>
</selector>